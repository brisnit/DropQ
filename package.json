{
  "name": "dropq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "db:backfill-customers": "node --env-file=.env prisma/backfill-customers.mjs",
    "db:seed-region": "node --env-file=.env prisma/seed-region.mjs",
    "db:seed-dropmeet": "node --env-file=.env prisma/seed-dropmeet-sd.mjs",
    "db:backfill-attribution": "node --env-file=.env prisma/backfill-attribution.mjs",
    "db:backfill-points": "node --env-file=.env prisma/backfill-points.mjs",
    "twilio:audit": "node --env-file=.env.vercel.local scripts/twilio-audit.mjs",
    "test:phase-a": "node --env-file=.env scripts/phase-a-selftest.mjs",
    "test:drop-schedule": "node --env-file=.env scripts/drop-schedule-selftest.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "test:browser:guidance": "node tests/browser/run.mjs guidance",
