# Copy to .env and fill in. Never commit your real .env.

# --- Database: Postgres (Neon / Vercel Postgres) ---
# DATABASE_URL          = pooled connection (used by the app at runtime)
# DATABASE_URL_UNPOOLED = direct connection (used by `prisma db push` / migrations)
# On Vercel, the Neon/Postgres integration injects both automatically.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# Session signing secret — set to a long random string
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Image uploads ---
# Set automatically when you add a Vercel Blob store. Leave blank locally to
# fall back to writing files in /public/uploads.
BLOB_READ_WRITE_TOKEN=

# Public base URL (used for email + Stripe links). Optional locally.
APP_URL=

# --- Stripe (leave blank to run in demo mode with no real payments) ---
# NOTE: an EMPTY value disables the sell gate locally (isStripeEnabled() is false,
# so isVendorSellable() allows everyone). Set any dummy value to test the real gate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform fee charged to vendors per transaction (percent)
DROPQ_FEE_PERCENT=2

# --- Email (free: Resend free tier; blank = dev mode, links logged to console) ---
RESEND_API_KEY=
EMAIL_FROM="DropQ <onboarding@resend.dev>"

# --- DropQ internal admin (comma-separated emails) ---
DROPQ_ADMIN_EMAILS=

# --- Cron (repeat-customer reminders). Vercel sends this as a Bearer token. ---
CRON_SECRET=

# --- SMS (future / placeholder — wire Twilio later) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Messaging notifications over SMS stay off until A2P 10DLC is approved AND the
# recipient has given express written consent. Set to "true" to switch on.
MESSAGING_SMS_ENABLED=

# --- DropMeet map (Mapbox) ---
# PUBLIC token only — it starts with "pk." and is inlined into the browser
# bundle by design. Never put a secret "sk." token here. Restrict it by URL in
# your Mapbox token settings so it can't be used off your domains.
# Leave blank and DropMeet still works: the list, search, filters and detail
# pages all render, with a "Map not configured" panel where the map would be.
# NOTE: NEXT_PUBLIC_* is baked in at BUILD time — changing it needs a redeploy.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Customer OAuth (Auth.js) — CUSTOMERS ONLY, never vendors ---
# Vendor auth (hp_session) is untouched by any of this.
# Auth.js is a front door: it does the OAuth handshake, we resolve the Customer,
# then mint the existing dq_customer cookie. Magic link stays a peer method.
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Google redirect URI to register:
#   https://www.drop-q.com/api/auth/callback/google
#
# Master switch for the "Continue with Google" button. Unset or anything other
# than "true" hides it entirely, so the feature deploys inert. NEXT_PUBLIC_* is
# baked in at BUILD time — flipping this needs a redeploy.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# In-person / walk-up sales (Phase D). SERVER-SIDE ONLY and default OFF —
# deliberately not NEXT_PUBLIC_, so availability stays authoritative even if the
# client bundle is modified. The server action re-checks it before creating
# anything. Leave unset until Phase E ships the customer /pay/{token} page;
# turning it on sooner lets a vendor ring up a cart nobody can pay.
# unset      -> off for everyone
# internal   -> ONLY vendors with Seller.internalKind set (the canary pilot)
# true       -> every eligible vendor
# Never bypasses payment safety: canStartInPersonSale() still requires Stripe.
WALKUP_ENABLED=

# ─────────────────────────────────────────────────────────────────────────────
# Analytics (Phase A)
#
#   off      no visitor identity, no events. THE DEFAULT, and what production
#            runs today. The privacy policy currently promises essential cookies
#            only, so turning this on is a policy decision, not a deploy.
#   on       identity cookies for everyone.
#   consent  identity cookies only after a consent UI sets dq_analytics_consent.
#
# Preview deployments never write regardless of this value — they share
# DATABASE_URL with production. See lib/analytics-identity.ts.
ANALYTICS_MODE=off
