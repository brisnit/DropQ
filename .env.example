# Copy to .env and fill in. Never commit your real .env.

# --- Database: Postgres (Neon / Vercel Postgres) ---
# DATABASE_URL          = pooled connection (used by the app at runtime)
# DATABASE_URL_UNPOOLED = direct connection (used by `prisma db push` / migrations)
# On Vercel, the Neon/Postgres integration injects both automatically.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# Session signing secret — set to a long random string
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Image uploads ---
# Set automatically when you add a Vercel Blob store. Leave blank locally to
# fall back to writing files in /public/uploads.
BLOB_READ_WRITE_TOKEN=

# Public base URL (used for email + Stripe links). Optional locally.
APP_URL=

# --- Stripe (leave blank to run in demo mode with no real payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform fee charged to vendors per transaction (percent)
DROPQ_FEE_PERCENT=2

# --- Email (free: Resend free tier; blank = dev mode, links logged to console) ---
RESEND_API_KEY=
EMAIL_FROM="DropQ <onboarding@resend.dev>"

# --- DropQ internal admin (comma-separated emails) ---
DROPQ_ADMIN_EMAILS=

# --- Cron (repeat-customer reminders). Vercel sends this as a Bearer token. ---
CRON_SECRET=

# --- SMS (future / placeholder — wire Twilio later) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Messaging notifications over SMS stay off until A2P 10DLC is approved AND the
# recipient has given express written consent. Set to "true" to switch on.
MESSAGING_SMS_ENABLED=

# --- DropMeet map (Mapbox) ---
# PUBLIC token only — it starts with "pk." and is inlined into the browser
# bundle by design. Never put a secret "sk." token here. Restrict it by URL in
# your Mapbox token settings so it can't be used off your domains.
# Leave blank and DropMeet still works: the list, search, filters and detail
# pages all render, with a "Map not configured" panel where the map would be.
# NOTE: NEXT_PUBLIC_* is baked in at BUILD time — changing it needs a redeploy.
NEXT_PUBLIC_MAPBOX_TOKEN=
