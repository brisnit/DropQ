// DropQ MVP — the operating system for modern food businesses.
// Core loop: Seller -> Drop -> Products -> (buyer) Orders -> OrderItems

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app at runtime (serverless-safe).
  url       = env("DATABASE_URL")
  // Direct connection used for migrations / `prisma db push`.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Seller {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  storeName    String
  slug         String   @unique
  tagline      String?
  bio          String?
  location     String?
  logoUrl      String?  // uploaded store logo (storefront avatar)
  accent       String   @default("#d25b2a") // brand accent for storefront
  emailVerified Boolean @default(false)
  isAdmin      Boolean  @default(false) // DropQ internal admin
  termsAcceptedAt DateTime? // when the vendor accepted the Vendor Agreement
  termsVersion    String?   // which version they accepted
  createdAt    DateTime @default(now())

  // Stripe Connect (payouts)
  stripeAccountId      String? @unique
  stripeChargesEnabled Boolean @default(false)

  // DropQ fee: "absorb" (store eats the fee) | "pass" (customer pays the fee)
  feeMode String @default("absorb")

  // Geofencing notifications (location + opt-in radius)
  geofenceEnabled Boolean @default(false)
  latitude        Float?
  longitude       Float?
  geofenceRadiusM Int     @default(1500) // meters

  drops       Drop[]
  orders      Order[]
  tokens      Token[]
  subscribers Subscriber[]
}

// Single-use, expiring tokens for email verification and password reset.
model Token {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type      String   // "verify" | "reset"
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([sellerId])
}

model Drop {
  id          String    @id @default(cuid())
  sellerId    String
  seller      Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("draft") // draft | live | closed
  fulfillment String    @default("pickup") // pickup | delivery | shipping
  pickupInfo  String?
  opensAt     DateTime?
  closesAt    DateTime?
  createdAt   DateTime  @default(now())

  products    Product[]
  orders      Order[]
  subscribers Subscriber[]
}

model Product {
  id          String  @id @default(cuid())
  dropId      String
  drop        Drop    @relation(fields: [dropId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priceCents  Int
  emoji       String  @default("🍪") // fallback visual when no photo uploaded
  imageUrl    String? // uploaded product photo (served from /uploads)
  inventory   Int     @default(0) // total units made available
  sold        Int     @default(0)
  sortOrder   Int     @default(0)

  orderItems OrderItem[]
}

model Order {
  id         String   @id @default(cuid())
  dropId     String
  drop       Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyerName  String
  buyerEmail String
  buyerPhone String?
  note       String?
  totalCents Int
  feeCents   Int      @default(0) // DropQ platform fee taken from this order
  status     String   @default("new") // pending | new | ready | fulfilled | canceled
  // Stripe
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  createdAt  DateTime @default(now())

  items OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Nullable + SetNull so a drop's products can be edited/removed without
  // breaking historical orders (name/price are snapshotted below).
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name       String
  priceCents Int
  quantity   Int
}

// Customers who sign up for future drops / opt into notifications.
model Subscriber {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dropId    String?
  drop      Drop?    @relation(fields: [dropId], references: [id], onDelete: SetNull)
  name      String?
  email     String?
  phone     String?
  optInNotifications Boolean @default(true) // future drops / marketing
  optInGeofence      Boolean @default(false)
  source    String   @default("waitlist") // waitlist | checkout | manual
  createdAt DateTime @default(now())

  @@index([sellerId])
  @@index([dropId])
}

// Tracks sent repeat-customer reminders so we never send duplicates.
model ReminderLog {
  id       String   @id @default(cuid())
  sellerId String
  email    String
  kind     String // "d30" | "d90"
  sentAt   DateTime @default(now())

  @@unique([sellerId, email, kind])
}
