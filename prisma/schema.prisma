// DropQ MVP — the operating system for modern food businesses.
// Core loop: Seller -> Drop -> Products -> (buyer) Orders -> OrderItems

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app at runtime (serverless-safe).
  url       = env("DATABASE_URL")
  // Direct connection used for migrations / `prisma db push`.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Seller {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  storeName    String
  slug         String   @unique
  tagline      String?
  bio          String?
  location     String?
  logoUrl      String?  // uploaded store logo (storefront avatar)
  headerImageUrl String? // uploaded storefront header/banner background
  accent       String   @default("#ff666c") // brand accent for storefront

  // Social media links (stored as full URLs)
  instagram String?
  tiktok    String?
  twitter   String?
  facebook  String?
  youtube   String?
  website   String?
  category     String   @default("food") // food | collectibles | apparel | art | other
  emailVerified Boolean @default(false)
  isAdmin      Boolean  @default(false) // DropQ internal admin
  disabledAt   DateTime? // set when an admin suspends the vendor (blocks login + storefront)
  termsAcceptedAt DateTime? // when the vendor accepted the Vendor Agreement
  termsVersion    String?   // which version they accepted
  createdAt    DateTime @default(now())

  // Subscription plan: starter | growth | partner | pro
  plan               String    @default("starter")
  dropsCreated       Int       @default(0) // lifetime drops created (Starter limit)
  partnerActivatedAt DateTime? // Early Partner Program start
  partnerExpiresAt   DateTime? // Partner auto-converts to Growth after this date

  // Referral program
  referralCode     String?   @unique // this vendor's invite code
  growthBonusUntil DateTime? // free Growth-level access earned via referrals

  // Sales rep attribution — set once at signup from ?ref=CODE; permanent unless
  // an admin changes it. See SalesRep / CommissionLedger.
  salesRepId       String?
  referralCodeUsed String?   // the raw code entered at signup
  referredAt       DateTime? // when attribution was set

  /// Marks a DropQ-controlled account: founder, canary/smoke-test, staff or the
  /// marketing demo store. NULL means real external commerce.
  ///
  /// Business KPIs (GMV, active vendors, conversion, retention) must exclude
  /// these; operational and financial views must NOT — a test order still has
  /// to be fulfilled, and a real Stripe charge is real money on a real
  /// connected account. Child rows are never flagged individually: Drops,
  /// Orders, WalkUpSales, PointsLedger and CustomerVendor all inherit through
  /// sellerId. See docs/TEST-DATA-AND-METRICS.md.
  ///
  /// Also the Walk-Up pilot cohort — see walkUpMode() in lib/walkup.ts.
  internalKind String?

  // Stripe Connect (payouts)
  stripeAccountId      String? @unique
  stripeChargesEnabled Boolean @default(false)
  /// The FIRST time this seller became Stripe charge-ready. An activation
  /// timestamp, NOT a representation of current status — `stripeChargesEnabled`
  /// remains authoritative for that. Set once on the first false->true
  /// transition and never overwritten or cleared, so that
  /// `!stripeChargesEnabled && stripeChargesEnabledAt != null` means "was
  /// selling, Stripe has since restricted them" — a different situation from
  /// "never finished onboarding", needing different words.
  /// NULL for vendors who were already charge-ready before this column existed;
  /// see docs/VENDOR-ACTIVATION.md §4.1 for why that is not backfilled.
  stripeChargesEnabledAt DateTime?

  // Stripe Billing (DropQ subscription charged to the vendor)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?
  subscriptionStatus   String? // active | past_due | canceled | incomplete

  // DropQ fee: "absorb" (store eats the fee) | "pass" (customer pays the fee)
  feeMode String @default("absorb")

  // IANA timezone for scheduling drops (e.g. "America/New_York"). Null = use the
  // vendor's browser timezone when scheduling.
  timezone        String?

  // Geofencing notifications (location + opt-in radius)
  geofenceEnabled Boolean @default(false)
  latitude        Float?
  longitude       Float?
  geofenceRadiusM Int     @default(1500) // meters

  // Public pickup contact — opt-in. When a number is present, customers of a
  // valid order can call/text the vendor at pickup. The private account phone is
  // never exposed; only this explicitly-entered number is public.
  pickupContactPhone String? // public pickup contact number (opt-in)
  pickupContactPref  String  @default("text") // text | call | both — preferred CTA

  // Vendor Finder / Discovery — strictly opt-in. A vendor only appears on
  // /discover when isDiscoverable is true. Public location fields are safe to
  // show (city/neighborhood level); exact addresses live on the drop and are
  // never exposed in discovery. Reusable by a future DropMaps feature.
  isDiscoverable             Boolean @default(false) // master opt-in switch
  showActiveDropsInDiscovery Boolean @default(true)  // show my live/upcoming drops
  showEventsInDiscovery      Boolean @default(true)  // show my pop-ups / markets (live drops)
  hideExactAddress           Boolean @default(true)  // never expose exact address in discovery
  publicNeighborhood String? // e.g. "East Austin"
  publicCity         String? // shown publicly; falls back to `location`
  publicState        String? // e.g. "TX"
  publicZip          String? // for zip-based search matching
  discoveryRadius    Int     @default(25) // vendor service radius in miles (informational)

  drops          Drop[]
  orders         Order[]
  tokens         Token[]
  subscribers    Subscriber[]
  reviews        Review[]
  gallery        GalleryImage[]
  vendorProducts VendorProduct[]
  referralsMade  Referral[]     @relation("Referrer")
  referredBy     Referral?      @relation("Referred")

  salesRep    SalesRep?          @relation("SalesRepVendors", fields: [salesRepId], references: [id], onDelete: SetNull)
  commissions CommissionLedger[] @relation("VendorCommissions")

  conversations Conversation[]
  sentMessages  Message[]      @relation("MessageSenderSeller")
  notifications Notification[]
  broadcasts    Broadcast[]

  // DropMeet
  appearances        VendorAppearance[]
  submittedLocations Location[]          @relation("LocationSubmittedBySeller")
  approvedLocations  Location[]          @relation("LocationApprovedByAdmin")
  submittedMarkets   Market[]            @relation("MarketSubmittedBySeller")
  approvedMarkets    Market[]            @relation("MarketApprovedByAdmin")
  claimedMarkets     Market[]            @relation("MarketClaimedBy")
  submittedEvents    Event[]             @relation("EventSubmittedBySeller")
  approvedEvents     Event[]             @relation("EventApprovedByAdmin")
  reviewedCandidates DropMeetCandidate[] @relation("CandidateReviewedBy")
  claimsMade         ClaimRequest[]      @relation("ClaimClaimant")
  claimsReviewed     ClaimRequest[]      @relation("ClaimReviewedBy")

  // Customer relationships
  acquiredCustomers   Customer[]       @relation("CustomerFirstVendor")
  customerRelationships CustomerVendor[]
  pointsAwarded         PointsLedger[]
  walkUpSales           WalkUpSale[]

  @@index([salesRepId])
}

// A DropQ sales rep / affiliate. Vendors who sign up with the rep's referral
// code are permanently attributed to them and earn the rep commission.
model SalesRep {
  id             String   @id @default(cuid())
  // The rep activates their dashboard by signing up/logging in as a normal
  // DropQ user with this same email; userId links to that Seller account.
  userId         String?  @unique
  name           String
  email          String   @unique
  phone          String?
  passwordHash   String?  // legacy (standalone portal) — activation is now email-match
  referralCode   String?  @unique // legacy — obsolete; signup links now use the rep id
  commissionRate Float    @default(0.01) // 1% — change here or per-rep to adjust
  status         String   @default("active") // active | inactive

  inviteSentAt     DateTime? // last time the invite email/SMS was sent
  inviteAcceptedAt DateTime? // when the rep first activated their dashboard

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendors     Seller[]           @relation("SalesRepVendors")
  commissions CommissionLedger[]
}

// One ledger row per vendor order attributed to a sales rep. Idempotent via the
// unique (orderId, salesRepId). Refunds add a voided/negative adjustment.
model CommissionLedger {
  id         String @id @default(cuid())
  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     Seller   @relation("VendorCommissions", fields: [vendorId], references: [id], onDelete: Cascade)

  orderId   String  // the order this commission is for
  paymentId String? // Stripe payment intent id, if available

  // All amounts in cents so reporting can recompute against any base.
  grossOrderAmount     Int  // order total
  vendorTakeAmount     Int  // gross - DropQ fee (what the vendor nets)
  dropqFeeAmount       Int? // DropQ platform fee, if known
  commissionBaseAmount Int  // the base the rate is applied to (see lib/commission.ts)
  commissionRate       Float
  commissionAmount     Int  // base * rate, rounded (can be negative for adjustments)

  status String @default("pending") // pending | approved | paid | voided
  notes  String?

  createdAt  DateTime  @default(now())
  approvedAt DateTime?
  paidAt     DateTime?
  voidedAt   DateTime?

  @@unique([orderId, salesRepId]) // idempotency: no duplicate commission per order
  @@index([salesRepId])
  @@index([vendorId])
  @@index([status])
}

// Vendor-to-vendor referrals. One reward per referred account (referredId unique).
model Referral {
  id              String    @id @default(cuid())
  referrerId      String
  referrer        Seller    @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId      String    @unique
  referred        Seller    @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  status          String    @default("signed_up") // signed_up | rewarded
  rewardGrantedAt DateTime?
  createdAt       DateTime  @default(now())

  @@index([referrerId])
}

// Storefront photo gallery (vendor-uploaded images).
model GalleryImage {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sellerId])
}

// Customer ratings + comments for a storefront.
model Review {
  id            String   @id @default(cuid())
  sellerId      String
  seller        Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  authorName    String
  serviceRating Int // 1-5 stars
  qualityRating Int // 1-5 stars
  comment       String?
  createdAt     DateTime @default(now())

  @@index([sellerId])
}

// Email captures for the (not-yet-purchasable) Pro plan.
model ProWaitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  sellerId  String? // set if a logged-in vendor joined
  storeName String?
  createdAt DateTime @default(now())
}

// Single-use, expiring tokens for email verification and password reset.
model Token {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type      String   // "verify" | "reset"
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([sellerId])
}

model Drop {
  id          String    @id @default(cuid())
  sellerId    String
  seller      Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("draft") // draft | live | closed
  mode        String    @default("preorder") // preorder (regular drop) | live (live selling / on-site QR)
  fulfillment String    @default("pickup") // pickup | delivery | handoff
  pickupInfo  String?   // legacy free-text location line (kept for back-compat)
  opensAt     DateTime? // order window start (UTC)
  closesAt    DateTime? // order window end (UTC) — ordering locks after this

  // Pickup window (after ordering closes) + structured-ish location.
  pickupStartAt      DateTime?
  pickupEndAt        DateTime?
  pickupLocationName String? // e.g. "Front porch", "The shop"
  pickupAddress      String? // formatted address (from autocomplete)
  pickupLat          Float?
  pickupLng          Float?
  pickupNotes        String? // pickup / delivery instructions
  pickupFindMe       String? // "how to find the vendor" — e.g. "Blue canopy near the fountain", "White Ford Transit"
  // Structured address components (best-effort, from the autocomplete provider).
  pickupLine1        String?
  pickupCity         String?
  pickupState        String?
  pickupPostal       String?
  pickupCountry      String?

  vendorArrivedAt DateTime? // vendor checked in at the pickup location

  // Discovery: a drop is eligible for /discover only when its vendor is
  // discoverable AND this is true. Defaults true so existing drops surface once
  // their vendor opts in; a vendor can mark a specific drop private.
  isPublic    Boolean   @default(true)

  createdAt   DateTime  @default(now())

  products    Product[]
  orders      Order[]
  subscribers Subscriber[]

  conversations Conversation[] @relation("ConversationLastDrop")
  messages      Message[]      @relation("MessageDrop")
  broadcasts    Broadcast[]

  // DropMeet — appearances where this drop is preorderable
  appearances VendorAppearance[]

  // Customers whose very first DropQ touch was this drop
  acquiredCustomers Customer[] @relation("CustomerFirstDrop")
  savedBy           SavedDrop[]
  walkUpSales       WalkUpSale[]

  @@index([status])
}

// A vendor's reusable product/menu-item library. Independent from any drop so
// vendors don't recreate the same items every time. A drop's Product may be
// spawned from one of these (Product.vendorProductId), but drop-specific fields
// (inventory, sold, per-drop price) live on the Product, not here.
model VendorProduct {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priceCents  Int      @default(0) // default/master price; overridable per drop
  emoji       String   @default("🍪")
  imageUrl    String?  // primary photo (kept in sync with images[0])
  images      String[] @default([])
  category    String?  // optional grouping (e.g. "Pastries", "Drinks")
  allergens   String?  // optional dietary/allergen notes
  productType String?  // collectible metadata (mirrors Product)
  condition   String?
  rarity      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dropProducts Product[] // drop items created from this library item

  @@index([sellerId])
}

model Product {
  id          String  @id @default(cuid())
  dropId      String
  drop        Drop    @relation(fields: [dropId], references: [id], onDelete: Cascade)
  // Optional link back to the saved library item this was created from. Nullable
  // so existing/ad-hoc drop products are unaffected; SetNull so deleting a
  // library item never breaks a live drop.
  vendorProductId String?
  vendorProduct   VendorProduct? @relation(fields: [vendorProductId], references: [id], onDelete: SetNull)
  name        String
  description String?
  priceCents  Int
  emoji       String  @default("🍪") // fallback visual when no photo uploaded
  imageUrl    String? // primary photo (kept in sync with images[0] for back-compat)
  images      String[] @default([]) // all product photos (gallery); first is primary
  inventory   Int     @default(0) // total units made available
  sold        Int     @default(0)
  sortOrder   Int     @default(0)

  // Optional metadata, used mainly by collectible / non-food storefronts
  productType String? // category / type (e.g. "Trading card", "Designer toy")
  condition   String? // e.g. "New", "Mint", "Used — good"
  rarity      String? // rarity / edition (e.g. "1 of 50", "Holo rare")

  orderItems OrderItem[]
}

model Order {
  id         String   @id @default(cuid())
  dropId     String
  drop       Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyerName  String
  buyerEmail String
  buyerPhone String?
  // Buyer contact stays denormalized on the order (it's a historical record of
  // what they typed at checkout). customerId links it to the durable Customer
  // identity used for messaging — nullable because pre-messaging orders are
  // backfilled by email, and SetNull so deleting a Customer never voids orders.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  note       String?
  totalCents Int
  feeCents   Int      @default(0) // DropQ platform fee taken from this order
  status     String   @default("new") // pending | new | in_progress | ready | completed | canceled (legacy: fulfilled)
  source     String   @default("online") // online (preorder/regular drop) | live (live QR / on-site POS)
  // unpaid | pending (Stripe session open) | paid | refund_pending | refunded | expired
  // DropQ takes card payment through Stripe only — there is no pay-in-person
  // option. "unpaid" means nobody has paid, not an agreed arrangement.
  paymentStatus String @default("unpaid")
  // Stripe
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  customerArrivedAt DateTime? // customer tapped "I'm here" at pickup
  createdAt  DateTime @default(now())

  items  OrderItem[]
  events OrderEvent[]

  conversations Conversation[] @relation("ConversationLastOrder")
  messages      Message[]      @relation("MessageOrder")
  walkUpSale    WalkUpSale?

  @@index([customerId])
}

// Timestamped audit trail of order lifecycle events.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // created | status | payment
  detail    String?  // e.g. the new status or payment state
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Nullable + SetNull so a drop's products can be edited/removed without
  // breaking historical orders (name/price are snapshotted below).
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name       String
  priceCents Int
  quantity   Int
}

// Customers who sign up for future drops / opt into notifications.
model Subscriber {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dropId    String?
  drop      Drop?    @relation(fields: [dropId], references: [id], onDelete: SetNull)
  name      String?
  email     String?
  phone     String?
  // Consent is tracked per channel. SMS marketing needs *express written
  // consent* under the TCPA and carriers (via A2P 10DLC review) can ask us to
  // produce it, so optInSms is its own unbundled, default-false field and we
  // stamp the moment it was given. optInNotifications is kept as the
  // any-channel rollup for existing reads.
  optInNotifications Boolean @default(true) // future drops / marketing (email OR sms)
  optInEmail         Boolean @default(true)
  optInSms           Boolean @default(false)
  smsConsentAt       DateTime? // when the SMS box was checked — proof of consent
  optInGeofence      Boolean @default(false)
  source    String   @default("waitlist") // waitlist | checkout | manual
  createdAt DateTime @default(now())

  @@index([sellerId])
  @@index([dropId])
}

// Tracks sent repeat-customer reminders so we never send duplicates.
model ReminderLog {
  id       String   @id @default(cuid())
  sellerId String
  email    String
  kind     String // "d30" | "d90"
  sentAt   DateTime @default(now())

  @@unique([sellerId, email, kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// MESSAGING
//
// DropQ is the canonical store for every message. Email/SMS/push are delivery
// channels layered on top (see MessageDelivery) — they are never the source of
// truth. A vendor's outbound text is a Message row first; any SMS that goes out
// is a *notification about* that Message, not the message itself.
//
//   Customer / Seller → Conversation → Message → Notification → MessageDelivery
// ─────────────────────────────────────────────────────────────────────────────

// A buyer's durable identity, global across vendors (a customer can hold
// conversations with several stores). Keyed on email, which is what checkout
// already collects and what the Customers page groups by today. Customers have
// no password — they authenticate with an emailed magic link (CustomerToken).
model Customer {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  phone      String?
  avatarUrl  String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// ── First-touch acquisition ──────────────────────────────────────────
  /// Which vendor brought this person to DropQ, and how. Written once, on
  /// the first interaction we can attribute, and never overwritten — a
  /// customer who later discovers ten other vendors is still *originally*
  /// vendor A's. Per-vendor relationships live on CustomerVendor.
  firstVendorId String?
  firstVendor   Seller? @relation("CustomerFirstVendor", fields: [firstVendorId], references: [id], onDelete: SetNull)
  firstDropId   String?
  firstDrop     Drop?   @relation("CustomerFirstDrop", fields: [firstDropId], references: [id], onDelete: SetNull)
  /// storefront | drop | qr | dropmeet | checkout | direct | admin
  signupSource     String?
  /// Free-form provenance for the entry point (a slug, a ref code, a share id).
  signupSourceDetail String?
  firstTouchAt     DateTime?
  firstPurchaseAt  DateTime?

  /// Reserved for saved payment methods (decision 2). Populated when
  /// SetupIntent-based card management ships; unused until then.
  stripeCustomerId String? @unique

  /// ── SMS consent (A2P 10DLC) ──────────────────────────────────────────
  /// Two independent consents, never inferred from each other or from any
  /// other action. Each records WHEN it was given, WHERE, and the exact
  /// disclosure version the customer saw, so a carrier audit can be answered
  /// with evidence rather than assertion.
  smsTransactionalConsent       Boolean   @default(false)
  smsTransactionalConsentAt     DateTime?
  smsTransactionalConsentSource String?
  smsMarketingConsent           Boolean   @default(false)
  smsMarketingConsentAt         DateTime?
  smsMarketingConsentSource     String?
  /// Version of the disclosure text accepted (see lib/sms-consent.ts).
  smsConsentDisclosureVersion   String?

  /// Set when the carrier or the customer replies STOP. A global kill switch:
  /// while set, no non-exempt message may be sent regardless of the flags above.
  smsOptedOutAt   DateTime?
  smsOptOutSource String? // "stop_reply" | "support" | "admin"

  orders        Order[]
  conversations Conversation[]
  sentMessages  Message[]       @relation("MessageSenderCustomer")
  notifications Notification[]
  tokens        CustomerToken[]

  // DropMeet
  submittedLocations Location[]       @relation("LocationSubmittedByCustomer")
  submittedMarkets   Market[]         @relation("MarketSubmittedByCustomer")
  locationFollows    LocationFollow[]
  marketFollows      MarketFollow[]

  vendorRelationships CustomerVendor[]
  savedDrops          SavedDrop[]
  oauthAccounts       CustomerAccount[]
  pointsLedger        PointsLedger[]

  @@index([firstVendorId])
}

// Single-use, expiring magic-link tokens for customer sign-in. Mirrors the
// vendor-side Token model but kept separate so customer auth can never widen
// the blast radius of vendor auth.
model CustomerToken {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  /// Intent captured when the link was requested, applied on redemption.
  /// Carrying it here rather than in the redirect URL means a follow can't be
  /// forged by editing the link — the customer opted in before it was issued.
  followSellerId String?

  @@index([customerId])
}

// The durable vendor↔customer relationship — exactly one per pair, reused
// across every drop they participate in. Drop/order context is *metadata*
// (lastDrop/lastOrder) plus per-message context, never a reason to fork a new
// thread.
model Conversation {
  id         String   @id @default(cuid())
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Most recent context, for the header and list rows. SetNull so deleting a
  // drop or order never destroys the conversation.
  lastDropId  String?
  lastDrop    Drop?   @relation("ConversationLastDrop", fields: [lastDropId], references: [id], onDelete: SetNull)
  lastOrderId String?
  lastOrder   Order?  @relation("ConversationLastOrder", fields: [lastOrderId], references: [id], onDelete: SetNull)

  // Denormalized so the list renders in one query instead of N.
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  lastMessageSender  String? // vendor | customer | system

  // Per-participant unread counters — cheap badges without aggregating Message.
  vendorUnread       Int       @default(0)
  customerUnread     Int       @default(0)
  vendorLastReadAt   DateTime?
  customerLastReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages      Message[]
  notifications Notification[]

  @@unique([sellerId, customerId])
  @@index([sellerId, lastMessageAt])
  @@index([customerId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Polymorphic sender: senderType is the discriminator, and exactly one of the
  // two FKs is set (system messages set neither).
  senderType       String // vendor | customer | system
  senderSellerId   String?
  senderSeller     Seller?   @relation("MessageSenderSeller", fields: [senderSellerId], references: [id], onDelete: SetNull)
  senderCustomerId String?
  senderCustomer   Customer? @relation("MessageSenderCustomer", fields: [senderCustomerId], references: [id], onDelete: SetNull)

  body        String
  messageType String @default("text") // text | announcement | system | order_update

  // Optional context this specific message is about.
  dropId  String?
  drop    Drop?   @relation("MessageDrop", fields: [dropId], references: [id], onDelete: SetNull)
  orderId String?
  order   Order?  @relation("MessageOrder", fields: [orderId], references: [id], onDelete: SetNull)

  // Set when this message was fanned out from a broadcast. Each recipient still
  // gets their own Message in their own Conversation — never a group thread.
  broadcastId String?
  broadcast   Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  deliveries    MessageDelivery[]
  notifications Notification[]

  @@index([conversationId, createdAt])
  @@index([broadcastId])
}

// One announcement the vendor composed, plus the audience it went to. The
// individual Messages are the real delivery; this row exists for reporting and
// as the hook for future scheduled/segmented sends.
model Broadcast {
  id       String  @id @default(cuid())
  sellerId String
  seller   Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dropId   String?
  drop     Drop?   @relation(fields: [dropId], references: [id], onDelete: SetNull)

  audience       String // drop_all | active_orders | ready_pickup | selected
  body           String
  recipientCount Int    @default(0)
  createdAt      DateTime @default(now())

  messages Message[]

  @@index([sellerId, createdAt])
}

// Per-user, per-event notification with deep-link context. recipientType is the
// discriminator; exactly one of sellerId/customerId is set.
model Notification {
  id            String  @id @default(cuid())
  recipientType String // vendor | customer
  sellerId      String?
  seller        Seller? @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type  String // message | announcement | order_update | system
  title String
  body  String?

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  dropId         String?
  orderId        String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sellerId, readAt, createdAt])
  @@index([customerId, readAt, createdAt])
}

// Audit of what we attempted per delivery channel for a message. in_app is
// always recorded; email/sms/push are opt-in add-ons. This is the seam that
// lets SMS be switched on later without the conversation system changing at
// all — a failed SMS never loses the message, it just marks a failed delivery.
model MessageDelivery {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  channel String // in_app | email | sms | push
  status  String @default("pending") // pending | sent | skipped | failed
  detail  String? // provider id, or the reason it was skipped/failed
  sentAt  DateTime?
  createdAt DateTime @default(now())

  @@unique([messageId, channel])
}

// ─────────────────────────────────────────────────────────────────────────────
// DROPMEET — the local discovery layer.
//
//   Region → Location → Market → MarketSchedule
//                    ↘ Event
//   Seller → VendorAppearance → (Location | Market | Event) + optional Drop
//
// Nothing here is public until an admin approves it. Every public-facing model
// carries status + verificationStatus + provenance (sourceType/sourceName/
// sourceUrl), so we can always answer "how did this record get here?".
//
// Status vocabulary (shared):
//   pending | approved | rejected | duplicate | needs_information
// Verification vocabulary (shared):
//   verified | organizer_claimed | community_submitted | imported | needs_verification
// ─────────────────────────────────────────────────────────────────────────────

/// A geographic area DropMeet is switched on for. Launch is San Diego County
/// only; adding Orange County later is a row, not a rewrite. boundaryGeoJson
/// holds the authoritative polygon (US Census TIGER) used for server-side
/// point-in-polygon checks; the bbox columns are a cheap pre-filter so most
/// rejects never touch the polygon math.
model Region {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  /// GeoJSON Polygon/MultiPolygon geometry, stored as text.
  boundaryGeoJson String?
  /// Provenance for the boundary itself.
  boundarySource  String?
  boundaryFetchedAt DateTime?

  minLatitude  Float?
  minLongitude Float?
  maxLatitude  Float?
  maxLongitude Float?

  defaultCenterLatitude  Float
  defaultCenterLongitude Float
  defaultZoom            Float @default(9)

  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations  Location[]
  markets    Market[]
  events     Event[]
  candidates DropMeetCandidate[]
}

/// A physical place where local commerce happens. Markets and Events point at
/// one; vendors appear at one.
model Location {
  id       String @id @default(cuid())
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  name         String
  slug         String  @unique
  locationType String  @default("other")
  description  String?

  address    String?
  city       String?
  state      String?
  postalCode String?
  latitude   Float
  longitude  Float

  websiteUrl   String?
  instagramUrl String?
  facebookUrl  String?
  phone        String?
  imageUrl     String?

  status             String @default("pending")
  verificationStatus String @default("community_submitted")

  sourceType String  @default("community_submission")
  sourceName String?
  sourceUrl  String?

  // Who put it here, who let it through.
  submittedBySellerId   String?
  submittedBySeller     Seller?   @relation("LocationSubmittedBySeller", fields: [submittedBySellerId], references: [id], onDelete: SetNull)
  submittedByCustomerId String?
  submittedByCustomer   Customer? @relation("LocationSubmittedByCustomer", fields: [submittedByCustomerId], references: [id], onDelete: SetNull)
  approvedByAdminId     String?
  approvedByAdmin       Seller?   @relation("LocationApprovedByAdmin", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?
  reviewNotes           String?
  lastVerifiedAt        DateTime?

  /// Set when this row was promoted out of the ingestion queue.
  candidateId String?
  /// Points at the surviving record when this one is closed as a duplicate.
  duplicateOfId String?
  duplicateOf   Location?  @relation("LocationDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Location[] @relation("LocationDuplicates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  markets     Market[]
  events      Event[]
  appearances VendorAppearance[]
  follows     LocationFollow[]
  claims      ClaimRequest[]
  vendorLeads VendorLead[]

  @@index([regionId, status])
  @@index([latitude, longitude])
  @@index([status, locationType])
}

/// A recurring organized marketplace at a Location.
model Market {
  id       String @id @default(cuid())
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  name        String
  slug        String  @unique
  description String?
  marketType  String  @default("other")

  websiteUrl   String?
  instagramUrl String?
  phone        String?
  imageUrl     String?

  organizerName  String?
  organizerEmail String?

  /// Claiming is a request an admin grants — never self-service.
  claimedBySellerId String?
  claimedBySeller   Seller? @relation("MarketClaimedBy", fields: [claimedBySellerId], references: [id], onDelete: SetNull)
  isClaimed         Boolean @default(false)
  claimedAt         DateTime?

  status             String @default("pending")
  verificationStatus String @default("community_submitted")

  sourceType String  @default("community_submission")
  sourceName String?
  sourceUrl  String?

  submittedBySellerId   String?
  submittedBySeller     Seller?   @relation("MarketSubmittedBySeller", fields: [submittedBySellerId], references: [id], onDelete: SetNull)
  submittedByCustomerId String?
  submittedByCustomer   Customer? @relation("MarketSubmittedByCustomer", fields: [submittedByCustomerId], references: [id], onDelete: SetNull)
  approvedByAdminId     String?
  approvedByAdmin       Seller?   @relation("MarketApprovedByAdmin", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?
  reviewNotes           String?
  lastVerifiedAt        DateTime?

  candidateId   String?
  duplicateOfId String?
  duplicateOf   Market?  @relation("MarketDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Market[] @relation("MarketDuplicates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules   MarketSchedule[]
  exceptions  MarketScheduleException[]
  events      Event[]
  appearances VendorAppearance[]
  follows     MarketFollow[]
  claims      ClaimRequest[]
  vendorLeads VendorLead[]

  @@index([regionId, status])
  @@index([status, marketType])
  @@index([locationId])
}

/// Structured recurrence for a market — never free text. One market can hold
/// several rules (e.g. a summer evening schedule alongside a winter one).
model MarketSchedule {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  /// weekly | monthly | one_time | seasonal
  recurrence String @default("weekly")

  /// 0=Sunday … 6=Saturday. Null for one_time.
  dayOfWeek Int?
  /// For monthly rules: 1–4 = first…fourth, -1 = last.
  weekOfMonth Int?
  /// For one_time rules, and the window bounds for seasonal rules.
  startDate DateTime?
  endDate   DateTime?

  /// Local wall-clock times, "HH:MM" 24h — a market opens at 9am local
  /// regardless of DST, so these are deliberately not UTC instants.
  ///
  /// Nullable because a source often gives us the day without the hours
  /// ("Sundays"). Recording the day is real information; inventing 9am–2pm to
  /// satisfy a NOT NULL would be fabrication. A rule with no times still drives
  /// the Today/This Weekend filters and renders as "Sundays · hours not listed".
  startTime String?
  endTime   String?
  timezone  String @default("America/Los_Angeles")

  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketId, active])
}

/// A specific date a market is closed, moved, or special.
model MarketScheduleException {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  /// The local calendar date affected (midnight local, stored UTC).
  date DateTime
  /// cancelled | closed | special_hours
  type String @default("cancelled")
  /// Overrides for special_hours.
  startTime String?
  endTime   String?
  note      String?

  createdAt DateTime @default(now())

  @@unique([marketId, date])
  @@index([marketId, date])
}

/// A dated occurrence. May stand alone or belong to a market.
model Event {
  id       String @id @default(cuid())
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  marketId   String?
  market     Market?   @relation(fields: [marketId], references: [id], onDelete: SetNull)

  name        String
  slug        String  @unique
  description String?
  eventType   String  @default("other")

  startDateTime DateTime
  endDateTime   DateTime?

  latitude  Float
  longitude Float

  imageUrl   String?
  websiteUrl String?

  status             String @default("pending")
  verificationStatus String @default("community_submitted")

  sourceType String  @default("community_submission")
  sourceName String?
  sourceUrl  String?

  submittedBySellerId String?
  submittedBySeller   Seller?   @relation("EventSubmittedBySeller", fields: [submittedBySellerId], references: [id], onDelete: SetNull)
  approvedByAdminId   String?
  approvedByAdmin     Seller?   @relation("EventApprovedByAdmin", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  reviewNotes         String?
  lastVerifiedAt      DateTime?

  candidateId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appearances VendorAppearance[]

  @@index([regionId, status, startDateTime])
  @@index([status, startDateTime])
  @@index([latitude, longitude])
}

/// "This vendor will be at this place on this date." Explicitly per-occurrence:
/// a vendor at a weekly market is a row per week, never a standing assumption
/// that they attend every time.
model VendorAppearance {
  id       String @id @default(cuid())
  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  marketId   String?
  market     Market?   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  eventId    String?
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// The drop customers can preorder ahead of this appearance.
  dropId String?
  drop   Drop?   @relation(fields: [dropId], references: [id], onDelete: SetNull)

  startDateTime DateTime
  endDateTime   DateTime?

  boothInfo String?
  notes     String?

  /// scheduled | confirmed | cancelled | completed
  status String @default("scheduled")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId, startDateTime])
  @@index([marketId, startDateTime, status])
  @@index([locationId, startDateTime, status])
  @@index([eventId, startDateTime, status])
  @@index([status, startDateTime])
}

model LocationFollow {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, locationId])
  @@index([locationId])
}

model MarketFollow {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, marketId])
  @@index([marketId])
}

/// Raw inbound record from any ingestion provider, before it is anything real.
/// Nothing is promoted to a Location/Market/Event without an admin acting on it.
model DropMeetCandidate {
  id       String  @id @default(cuid())
  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  /// location | market | event
  entityType String
  /// community_submission | manual_research | import | places_api | organizer
  sourceType String
  sourceName String?
  sourceUrl  String?
  /// Provider's own id, for idempotent re-imports.
  externalId String?

  rawName        String
  rawAddress     String?
  rawSchedule    String?
  rawDescription String?
  rawWebsite     String?
  rawPhone       String?

  latitude  Float?
  longitude Float?

  /// Cleaned, admin-editable payload applied on approval.
  normalizedData  Json?
  confidenceScore Float?

  /// Result of the server-side region check at ingest time.
  insideRegion Boolean?

  /// pending | approved | rejected | duplicate | needs_review
  status String @default("pending")

  /// Set once promoted, so we can trace a live record back to its source.
  promotedLocationId String?
  promotedMarketId   String?
  promotedEventId    String?

  suggestedDuplicateId String?
  reviewNotes          String?
  reviewedByAdminId    String?
  reviewedByAdmin      Seller?   @relation("CandidateReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, externalId])
  @@index([status, entityType])
  @@index([regionId, status])
}

/// "I run this market" — a request, never an automatic grant.
model ClaimRequest {
  id String @id @default(cuid())

  /// location | market
  entityType String
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  marketId   String?
  market     Market?   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  name         String
  email        String
  role         String?
  organization String?
  message      String?

  /// Set when the claimant was signed in as a vendor.
  claimantSellerId String?
  claimantSeller   Seller? @relation("ClaimClaimant", fields: [claimantSellerId], references: [id], onDelete: SetNull)

  /// pending | approved | rejected
  status            String    @default("pending")
  reviewedByAdminId String?
  reviewedByAdmin   Seller?   @relation("ClaimReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNotes       String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([locationId])
  @@index([marketId])
}

/// "Know a vendor who sells here?" — a growth lead, not an account.
model VendorLead {
  id String @id @default(cuid())

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  marketId   String?
  market     Market?   @relation(fields: [marketId], references: [id], onDelete: SetNull)

  businessName   String
  website        String?
  email          String?
  phone          String?
  submitterEmail String?

  /// new | contacted | joined | rejected
  status String @default("new")
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}


/// The customer↔vendor relationship. One row per pair, created the first time
/// they interact — a follow, a purchase, or signing up through that vendor.
///
/// Distinct from Customer.firstVendorId on purpose: that records who brought
/// them to the platform and never changes, while this accumulates every vendor
/// they go on to deal with. A customer acquired by vendor A who later buys from
/// vendor B has one CustomerVendor row per vendor and still attributes their
/// acquisition to A.
model CustomerVendor {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// Set when they explicitly follow. Null means the relationship exists
  /// (they bought something) but they haven't opted into hearing from them.
  followedAt DateTime?

  firstPurchaseAt DateTime?
  lastPurchaseAt  DateTime?
  orderCount      Int       @default(0)
  totalSpentCents Int       @default(0)

  /// How the relationship started: purchase | follow | signup | dropmeet | import
  relationshipSource String @default("purchase")

  /// Marketing consent, per vendor and per channel. Never inferred: buying is
  /// not consent, and neither is following. Following means "tell me when they
  /// drop" in-app; these mean "you may market to me on this channel".
  ///   has_purchased  -> orderCount > 0
  ///   is_following   -> followedAt
  emailMarketingConsent   Boolean   @default(false)
  smsMarketingConsent     Boolean   @default(false)
  pushNotificationConsent Boolean   @default(false)
  consentUpdatedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, sellerId])
  @@index([sellerId, followedAt])
  @@index([customerId, lastPurchaseAt])
}


/// A drop a customer saved for later. Server-side and cross-device, unlike the
/// localStorage-only save in lib/saved-store.ts, which is per-browser and
/// invisible to the rest of the platform.
model SavedDrop {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dropId     String
  drop       Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, dropId])
  @@index([dropId])
  @@index([customerId, createdAt])
}


/// Links an OAuth identity (Google today, Apple later) to a DropQ Customer.
///
/// Deliberately NOT Auth.js's default `Account` model: Auth.js's Prisma adapter
/// expects a `User` table, which would compete with `Customer` as the identity.
/// Auth.js runs with JWT sessions instead and this table is written by our own
/// linking step, so `Customer` stays the single customer identity.
///
/// The unique on (provider, providerAccountId) is what makes repeat logins
/// resolve to the same Customer instead of creating duplicates.
model CustomerAccount {
  id                String   @id @default(cuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  provider          String   // "google" | "apple"
  providerAccountId String   // the provider's stable subject id
  /// Email as the provider asserted it, kept for audit. May differ from
  /// Customer.email (e.g. a future Apple private-relay address).
  providerEmail     String?

  createdAt         DateTime @default(now())
  lastLoginAt       DateTime?

  @@unique([provider, providerAccountId])
  @@index([customerId])
}


/// DropPoints — append-only ledger, not a balance column.
///
/// A balance is a derived fact; the ledger is the fact. Append-only means every
/// point is traceable to the order that earned it, a refund is a negative row
/// rather than a silent decrement, and the balance can always be recomputed if
/// something goes wrong. Loyalty balances are exactly the kind of number
/// customers notice being wrong.
///
/// Earn rate: $1 spent = 1 DropPoint (see lib/rewards.ts).
///
/// Scope: sellerId null = DropQ-wide points; sellerId set = earned with that
/// vendor. Both are recorded on every purchase so either redemption model
/// (DropQ-wide, or vendor-specific rules like "100 pts -> free item") can be
/// built later without a backfill.
///
/// DELIBERATELY NOT BUILT YET: redemption. Points have no dollar value assigned
/// and cannot be spent. See docs/CUSTOMER-PLATFORM-ROADMAP.md decision 3.
model PointsLedger {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// null = DropQ-wide. Set = attributable to this vendor.
  sellerId String?
  seller   Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  orderId String?
  /// Positive to earn, negative to reverse. Never update a row — append.
  points  Int
  /// purchase | purchase_reversal | adjustment
  reason  String
  note    String?

  createdAt DateTime @default(now())

  /// Idempotency: one earn row and one reversal row per order. Nullable
  /// orderId means manual adjustments aren't constrained (Postgres allows
  /// multiple NULLs in a unique index).
  @@unique([orderId, reason])
  @@index([customerId, createdAt])
  @@index([sellerId, customerId])
}

/// A vendor-initiated in-person sale, waiting for a customer to pay on their
/// own phone. Deliberately NOT an Order: when the vendor rings items up nobody
/// has identified themselves yet, and Order.buyerName/buyerEmail are NOT NULL.
/// Abandonment at a market is routine, so this keeps throwaway carts out of the
/// Order table entirely.
///
/// The Order is created at /pay/{token} once the customer gives an email, in
/// the same request as the Stripe Checkout Session — so a walk-up order enters
/// the pipeline in exactly the same `pending`/stock-unclaimed shape as an
/// online one, and finalizePaidOrder needs no changes.
///
/// State is DERIVED, never stored, so it cannot contradict itself:
///   open      orderId IS NULL AND canceledAt IS NULL AND expiresAt > now()
///   converted orderId IS NOT NULL
///   canceled  canceledAt IS NOT NULL
///   expired   otherwise
model WalkUpSale {
  id String @id @default(cuid())

  /// Public secret in the QR / payment link. Separate from `id` and generated
  /// from crypto.randomBytes: the QR is displayed on a screen in public, and a
  /// guessable id would let a stranger convert someone else's sale.
  token String @unique

  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// Required: OrderItem -> Product -> Drop, and Order.dropId is NOT NULL, so a
  /// walk-up sale is always scoped to one of the vendor's drops.
  dropId String
  drop   Drop   @relation(fields: [dropId], references: [id], onDelete: Cascade)

  /// The rung-up cart: [{ productId, name, priceCents, quantity }].
  /// Json rather than a child table because this is a throwaway cart that is
  /// never reported on or joined — OrderItem is the durable record. Json also
  /// means the snapshot's shape can change in later phases with no migration.
  /// Whether the snapshotted price or the live Product price is authoritative
  /// at conversion is a Phase E policy decision, not a schema one.
  lines Json

  /// Set exactly once, when a customer converts the sale. @unique is the
  /// idempotency guarantee: two phones scanning the same QR cannot both produce
  /// an order.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Bounds how long a photographed QR stays chargeable.
  expiresAt  DateTime
  /// Vendor tapped "start over". Nullable timestamp rather than a status
  /// string so it can never disagree with orderId.
  canceledAt DateTime?
  createdAt  DateTime  @default(now())

  /// The vendor's open sales.
  @@index([sellerId])
  /// The expiry sweep.
  @@index([expiresAt])
}
